      "updated": 1722181222190,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Multiplication pour les operandes de 16 bits\n\n    le multiplicateur doit etre dans le registre AX\n    le multiplicande est dans la source\n\n    Le resultat est dans le registre AX et DX\n        AX contient les deux octets les moins significatifs\n        DX contient les deux octets les plus significatifs",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Multiplication pour les operandes de 16 bits\n\n    le multiplicateur doit etre dans le registre AX\n    le multiplicande est dans la source\n\n    Le resultat est dans le registre AX et DX\n        AX contient les deux octets les moins significatifs\n        DX contient les deux octets les plus significatifs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 1884,
      "versionNonce": 1236461320,
      "index": "bPC",
      "isDeleted": false,
      "id": "5miVlA0ubXiSHFZj8qbCR",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -2946.6629542846354,
      "y": 1897.7266767233998,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1009.8873291015625,
      "height": 856.5623109422377,
      "seed": 1606982776,
