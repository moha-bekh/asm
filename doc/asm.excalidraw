    {
      "type": "text",
      "version": 5605,
      "versionNonce": 168401672,
      "index": "bPO",
      "isDeleted": false,
      "id": "biWQfqlmKHoge7bFmbuM7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -2578.730828743902,
      "y": 4303.94296533911,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 716.3793334960938,
      "height": 425,
      "seed": 1019623688,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1722181222190,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Syntaxe\n\n    NEG r\n    NEG opmem\n\n    Complemetn a 2 d'un octet ou d'un mot\n    NEG r -> != r + 1\n    NEG opmem -> != opmem + 1\n\nEX :\n\n    MOV AL, 0Fh    ;   AL = 0000 1111\n    NEG AL           ;   AL = 1111 0001\n\nNote:\n    Les bits qui peuvent etre modifies par les operateurs logiques sont\n    ZF, SF, PF",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntaxe\n\n    NEG r\n    NEG opmem\n\n    Complemetn a 2 d'un octet ou d'un mot\n    NEG r -> != r + 1\n    NEG opmem -> != opmem + 1\n\nEX :\n\n    MOV AL, 0Fh    ;   AL = 0000 1111\n    NEG AL           ;   AL = 1111 0001\n\nNote:\n    Les bits qui peuvent etre modifies par les operateurs logiques sont\n    ZF, SF, PF",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
