      "fontSize": 59.16548414230693,
      "fontFamily": 5,
      "text": "Forme d'instructions",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Forme d'instructions",
      "autoResize": true,
