    {
      "type": "text",
      "version": 4382,
      "versionNonce": 1859748360,
      "index": "bPH",
      "isDeleted": false,
      "id": "46MmKoggBFq6RoQ6vdty5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -4485.8511933623595,
      "y": 3415.4136479861186,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 750.2393798828125,
      "height": 525,
      "seed": 1287846520,
      "groupIds": [],
