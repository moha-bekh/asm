    {
      "type": "text",
      "version": 6212,
      "versionNonce": 1041529096,
      "index": "bPQ",
      "isDeleted": false,
      "id": "kDoeEfI_yhpr725XMcPDl",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -4463.047340896952,
      "y": 5191.963882093415,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 837.059326171875,
      "height": 375,
      "seed": 1961139320,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1722181222190,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Syntaxe\n\n    OP dst, nb\n\n        Destination : un registre ou un operande memoire de 8 bits ou de 16 bits\n\n        nb : nombre de decalgage ou de rotations\n\nSi nb = 1  ->  un seul decalage ou rotation\n                on utilise l'adressage immediat\n\nSi nb > 1  ->  plusieurs\n                nb sera charge dans le registre CL\n\nLe nombre de decalage ou de rotation est compris entre 1 et 255",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntaxe\n\n    OP dst, nb\n\n        Destination : un registre ou un operande memoire de 8 bits ou de 16 bits\n\n        nb : nombre de decalgage ou de rotations\n\nSi nb = 1  ->  un seul decalage ou rotation\n                on utilise l'adressage immediat\n\nSi nb > 1  ->  plusieurs\n                nb sera charge dans le registre CL\n\nLe nombre de decalage ou de rotation est compris entre 1 et 255",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 1708,
      "versionNonce": 774903816,
      "index": "bPR",
      "isDeleted": false,
      "id": "xk-AVb6MLz5IGh2Gfo4uu",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -4519.889651238185,
      "y": 5124.4856887158,
      "strokeColor": "#1e1e1e",
