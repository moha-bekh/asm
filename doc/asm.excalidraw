    {
      "type": "text",
      "version": 6495,
      "versionNonce": 2004866824,
      "index": "bPS",
      "isDeleted": false,
      "id": "Azt1ulo1W1LsYyoTDP5OH",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -3332.9842657092136,
      "y": 5191.963882093415,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 487.89971923828125,
      "height": 375,
      "seed": 732003848,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1722181222190,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Syntaxe\n\n    SAL dst, nb (operande signe Ca2)\n\n    CF  <-  SAL  <-  0\n\nEx :\n\n    MOV AL, 1010 1100b\n    SAL AL, 1   ; (AL)  = 0101 1000b  , (CF) = 1\n\n    MOV CL, 2\n    MOV BL, 1100 1011b\n    SAL BL, CL  ; (BL) = 0010 1100b  , (CF) = 1\n    ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntaxe\n\n    SAL dst, nb (operande signe Ca2)\n\n    CF  <-  SAL  <-  0\n\nEx :\n\n    MOV AL, 1010 1100b\n    SAL AL, 1   ; (AL)  = 0101 1000b  , (CF) = 1\n\n    MOV CL, 2\n    MOV BL, 1100 1011b\n    SAL BL, CL  ; (BL) = 0010 1100b  , (CF) = 1\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 1773,
      "versionNonce": 511686152,
      "index": "bPT",
