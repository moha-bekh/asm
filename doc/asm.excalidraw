      "versionNonce": 1127283208,
      "index": "bPP",
      "isDeleted": false,
      "id": "XHj5L86g_fforP5bBGnNE",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
