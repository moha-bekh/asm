    {
      "type": "text",
      "version": 8101,
      "versionNonce": 411895416,
      "index": "bRI",
      "isDeleted": false,
      "id": "tRjVm1zEB7vrTlQb0qQPB",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2486.5489893681083,
      "y": 5433.326067442663,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 539.1196899414062,
      "height": 375,
      "seed": 1690461560,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": null,
      "updated": 1722188524310,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Afficher un caractere :\n    \n    MOV AH, 02h   ; fonction no. 2\n    MOV DL, 'a'   ;  caractere a transferer dans dl\n    INT 21h   ;  qppel a MS-DOS\n\nAfficher un messgae :\n\n    .data\n        msg db 'Hello world!', 13, 10, '$'\n    .code\n\n        MOV AH, 09h  ;  fonction no. 9\n        MOV DX, offset msg  ;  pointe vers la msg\n        INT 21H",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Afficher un caractere :\n    \n    MOV AH, 02h   ; fonction no. 2\n    MOV DL, 'a'   ;  caractere a transferer dans dl\n    INT 21h   ;  qppel a MS-DOS\n\nAfficher un messgae :\n\n    .data\n        msg db 'Hello world!', 13, 10, '$'\n    .code\n\n        MOV AH, 09h  ;  fonction no. 9\n        MOV DX, offset msg  ;  pointe vers la msg\n        INT 21H",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
