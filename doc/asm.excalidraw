      "fontSize": 59.16548414230693,
      "fontFamily": 5,
      "text": "Instructions de transfert",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instructions de transfert",
      "autoResize": true,
