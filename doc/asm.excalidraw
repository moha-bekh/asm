    {
      "type": "text",
      "version": 6789,
      "versionNonce": 942388488,
      "index": "bPU",
      "isDeleted": false,
      "id": "5-qsy15FPuuvpUfNCBUxn",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -2676.4139281373305,
      "y": 5190.803863829154,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 612.8394775390625,
      "height": 450,
      "seed": 1245650296,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1722181222190,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Syntaxe\n\n    SAR dst, nb (operande signe Ca2)\n\n    |->    SAR  ->  CF\n\nEx :\n\n    MOV AL, 1011 1110b\n    SAR AL, 1   ; (AL)  = 1101 111b  , (CF) = 0\n\n    MOV CL, 3\n    MOV BL, 1100 1011b\n    SAR BL, CL  ; (BL) = 1111 1001b  , (CF) = 0\n    \nNote:\n    1 decalage arithmetique a gauche = 1 multiplication par 2\n    1 decalage arithmetique a droite = 1 division par 2",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntaxe\n\n    SAR dst, nb (operande signe Ca2)\n\n    |->    SAR  ->  CF\n\nEx :\n\n    MOV AL, 1011 1110b\n    SAR AL, 1   ; (AL)  = 1101 111b  , (CF) = 0\n\n    MOV CL, 3\n    MOV BL, 1100 1011b\n    SAR BL, CL  ; (BL) = 1111 1001b  , (CF) = 0\n    \nNote:\n    1 decalage arithmetique a gauche = 1 multiplication par 2\n    1 decalage arithmetique a droite = 1 division par 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
