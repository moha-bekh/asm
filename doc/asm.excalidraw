    {
      "type": "text",
      "version": 3388,
      "versionNonce": 472694280,
      "index": "bNL",
      "isDeleted": false,
      "id": "iF3z77f_U2ViksmYIZnp3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -8771.77272116715,
      "y": 1406.3316702705038,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 643.6395263671875,
