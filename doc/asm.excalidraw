    {
      "type": "text",
      "version": 5011,
      "versionNonce": 1599512584,
      "index": "bPJ",
      "isDeleted": false,
      "id": "X1F0ZUPPpeo00wBVv4s9N",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -4462.714264490118,
      "y": 4302.958240048589,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1102.0191650390625,
      "height": 650,
      "seed": 857645432,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1722181222190,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Syntaxe\n\n    OP dst, src\n        Destination recoit le resultat de l'operation logique.\n        Source est appelee un masque, elle est utilisee pour positionner a 1 ou a 0 les bits de la destination\n\nDifferentes formes:\n\n    1. OP r1, r2\n    2. OP r, opmem\n    3. OP opmem, r\n    4. OP r, opimd\n    5. OP opmem, opimd\n\nEX :\n\n        MOV BL, 1000 1000b\n        AND BL, 1000 0000b\n\n        ; positionnement a 0 du 4eme bit.\n\n        \n        MOV AL, 1100 0000b\n        OR  AL, 0000 1111b\n\n        ; positionnement a 1 des 4 premiers bits",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntaxe\n\n    OP dst, src\n        Destination recoit le resultat de l'operation logique.\n        Source est appelee un masque, elle est utilisee pour positionner a 1 ou a 0 les bits de la destination\n\nDifferentes formes:\n\n    1. OP r1, r2\n    2. OP r, opmem\n    3. OP opmem, r\n    4. OP r, opimd\n    5. OP opmem, opimd\n\nEX :\n\n        MOV BL, 1000 1000b\n        AND BL, 1000 0000b\n\n        ; positionnement a 0 du 4eme bit.\n\n        \n        MOV AL, 1100 0000b\n        OR  AL, 0000 1111b\n\n        ; positionnement a 1 des 4 premiers bits",
      "autoResize": true,
      "lineHeight": 1.25
    },
