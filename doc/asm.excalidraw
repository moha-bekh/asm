    {
      "type": "text",
      "version": 1900,
      "versionNonce": 1178923272,
      "index": "bME",
      "isDeleted": false,
      "id": "Ny8UN4sjKDuiuAKOGYWxP",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -9071.545637806805,
      "y": -891.0414194532382,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 549.4595336914062,
      "height": 750,
      "seed": 1119502356,
      "groupIds": [],
