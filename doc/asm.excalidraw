      "version": 1098,
      "versionNonce": 84594440,
      "index": "bNa",
      "isDeleted": false,
      "id": "yyY4NGxbiSFeq6V1AzxkX",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
