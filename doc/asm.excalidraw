    {
      "type": "text",
      "version": 7612,
      "versionNonce": 618532216,
      "index": "bR5",
      "isDeleted": false,
      "id": "DSj4jUtmXXO1e1xv1lV72",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1302.0489893681083,
      "y": 5375.326067442663,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 927.3392333984375,
      "height": 350,
      "seed": 1441515272,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": null,
      "updated": 1722187927292,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Syntaxe\n    \n    INT type\n   \n    Appel a une routine de service de l'interruption logicielle indiquee par le type\n\n    type : un nombre code en hexa sur octet de 00 a FF\n    On a au total 256 interruptions\n\nNote :\n    \n    Ce type d'interruption est toujours accepte par le microprocesseur\n    Le processus de traitement de ces interruptions commence a partir de la troisieme etape\n    Elles sont utilisees par le programmeur en cas de besoin",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntaxe\n    \n    INT type\n   \n    Appel a une routine de service de l'interruption logicielle indiquee par le type\n\n    type : un nombre code en hexa sur octet de 00 a FF\n    On a au total 256 interruptions\n\nNote :\n    \n    Ce type d'interruption est toujours accepte par le microprocesseur\n    Le processus de traitement de ces interruptions commence a partir de la troisieme etape\n    Elles sont utilisees par le programmeur en cas de besoin",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
