    {
      "type": "text",
      "version": 8058,
      "versionNonce": 807634952,
      "index": "bNh",
      "isDeleted": false,
      "id": "GTyCeFGPhcqXiqJ9NlNlK",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -6414.932844220284,
      "y": 4332.048806808338,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1122.4390869140625,
      "height": 400,
      "seed": 1189380277,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1722181222190,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Syntax\n    \n    - XCHG dest, src\n    - Echange de contenu entre la source et la destination. Destination et source doivent etre de la meme taille\n\nDifferentes formes:\n\n    XCHG registre1, registre2\n    XCHG registre, oper memoire\n    XCHG oper memoire, registre\n\nEX:\n    \n    MOV BL, 20\n    MOV CL, 10\n    XCHG CL, BL",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntax\n    \n    - XCHG dest, src\n    - Echange de contenu entre la source et la destination. Destination et source doivent etre de la meme taille\n\nDifferentes formes:\n\n    XCHG registre1, registre2\n    XCHG registre, oper memoire\n    XCHG oper memoire, registre\n\nEX:\n    \n    MOV BL, 20\n    MOV CL, 10\n    XCHG CL, BL",
      "autoResize": true,
      "lineHeight": 1.25
    },
