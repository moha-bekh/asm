      "fontSize": 20,
      "fontFamily": 5,
      "text": "_func:\n\n    push rbp\n    mov rbp, rsp\n    sub rsp, 8 + 16\n\n    mov rax, [rbp + ]\n\n    ; mov [rbp - 8], rdi\n    ; mov [rbp - 16], rsi\n    ; mov rax, [rbp - 8]\n    ; add rax, [rbp - 16]\n\n    add rsp, 8 + 16\n    mov rsp, rbp\n    pop rbp\n    ret\n\n_start:\n    \n    sub rsp, 8\n\n    mov rdi, 10\n    mov rsi, 20\n    call _func\n    jmp _exit:\n\n_exit:\n    \n    add rsp, 8\n\n    mov rax, _SYS_EXIT\n    xor rdi, rdi\n    syscall",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "_func:\n\n    push rbp\n    mov rbp, rsp\n    sub rsp, 8 + 16\n\n    mov rax, [rbp + ]\n\n    ; mov [rbp - 8], rdi\n    ; mov [rbp - 16], rsi\n    ; mov rax, [rbp - 8]\n    ; add rax, [rbp - 16]\n\n    add rsp, 8 + 16\n    mov rsp, rbp\n    pop rbp\n    ret\n\n_start:\n    \n    sub rsp, 8\n\n    mov rdi, 10\n    mov rsi, 20\n    call _func\n    jmp _exit:\n\n_exit:\n    \n    add rsp, 8\n\n    mov rax, _SYS_EXIT\n    xor rdi, rdi\n    syscall",
      "autoResize": true,
      "lineHeight": 1.25
